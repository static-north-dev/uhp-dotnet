<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RestoreAdditionalProjectSources Condition="'$(UseUhpPackages)' == 'true'">$(RestoreAdditionalProjectSources);$(PackageOutputPath)</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseUhpPackages)' != 'true'">
    <ProjectReference Include="../../src/StaticNorth.Uhp.Server/StaticNorth.Uhp.Server.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseUhpPackages)' == 'true'">
    <PackageReference Include="StaticNorth.Uhp.Server" Version="$(Version)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="11.0.0" PrivateAssets="all" />
    <ProjectReference Include="../../tests/StaticNorth.Uhp.TestSupport/StaticNorth.Uhp.TestSupport.csproj" />
  </ItemGroup>
</Project>
